{
  "reviewedOn": "2026-08-24",
  "sources": [
    "https://docs.polymarket.com/trading/combos/market-makers.md",
    "https://combos-rfq-api.polymarket.com/v1/rfq/combo-markets"
  ],
  "sourceSha256": {
    "https://docs.polymarket.com/trading/combos/market-makers.md": "2ebce652431e732c07356c207c623181d880d3e9c1beb61a77790357837d2232"
  },
  "docSection": "Get Combo Markets",
  "note": "The Combo markets catalog is how leg Position IDs are discovered. It replaces any local CTF position-id computation, which is out of scope for this SDK.",

  "endpoint": {
    "method": "GET",
    "host": "https://combos-rfq-api.polymarket.com",
    "path": "/v1/rfq/combo-markets",
    "authenticated": false,
    "ordering": "markets are ordered by volume descending"
  },

  "query": {
    "limit": {
      "documented": "--data-urlencode \"limit=50\"",
      "observedMinimum": 1,
      "observedMaximum": 100,
      "observedOn": "2026-08-24",
      "rejectionBodies": {
        "0": "{\"error\":\"invalid limit\"}",
        "101": "{\"error\":\"invalid rfq: invalid limit\"}"
      }
    },
    "cursor": "opaque; send back the previous page's next_cursor verbatim",
    "exclude": "comma-separated condition_id list; omits those markets from the page"
  },

  "responseFields": {
    "topLevel": ["markets", "next_cursor"],
    "market": ["id", "condition_id", "position_ids", "slug", "title", "outcomes", "outcome_prices", "image", "volume", "tags"],
    "undocumentedButObserved": ["pending"]
  },

  "indexAlignment": {
    "rule": "position_ids, outcomes and outcome_prices are aligned by array index. Index 0 is the YES outcome, index 1 is the NO outcome.",
    "yesIndex": 0,
    "noIndex": 1
  },
  "nextCursor": {
    "nullMeansNoMorePages": true,
    "observedFirstPageCursorAtLimitTwo": "NA"
  },
  "idKind": "position_ids are the underlying market outcome position IDs a Combo RFQ names as leg_position_ids - not CLOB token IDs and not the derived Combo position ID",

  "documentedExampleResponse": {
    "markets": [
      {
        "id": "1897034",
        "condition_id": "0x4cd7...110ff",
        "position_ids": ["1012585...362880", "1012585...362881"],
        "slug": "fifwc-mex-rsa-2026-06-11-mex",
        "title": "Will Mexico win on 2026-06-11?",
        "outcomes": ["Yes", "No"],
        "outcome_prices": ["0.685", "0.315"],
        "image": "<image-url>",
        "volume": 330327.7128580074,
        "tags": ["sports", "soccer", "games", "world-cup"]
      }
    ],
    "next_cursor": "Mg"
  },

